local belongsinstorage={}

--tables--

remote.OnClientInvoke = function(Obj,Var,setto)
	for i,v in pairs(serverindex) do
		if v[2]==Obj then
			v[1][Var]=setto
		end
	end
	return;
end

--functions--

function updateproperties(Object,reeee)
	if Object:IsDescendantOf(game) then
	local t={}
		local rs,err = pcall(function()
			for i,a in pairs(Data) do
				local rs,err = pcall(function()
			if not find(isserverinstance,Object) then
					if a~="Parent" then
					local rs,err = pcall(function()
						if Object[a]~=reeee[a] then
							local t={}
							if find(index,Object[a]) then
								local num =find(index,Object[a])
								local instance=serverindex[num][2]
								t={reeee,a,instance,Object}
							else
								t={reeee,a,Object[a],Object}
							end
									for i,v in pairs(queue) do
										if v[2]==a and v[1]==reeee then
											table.remove(queue,i)
										end
									end
							table.insert(queue,t)
						end
					end)
				end
			end
				end)
			end
		end)
	end
end

function partchanged(Object,reeee,property)
	pcall(function()
		if reeee[property]~=Object[property] and find(Data,property) then
			for i,v in pairs(queue) do
				if v[2]==property and v[1]==reeee then
					table.remove(queue,i)
				end
			end

			local t={}
			if find(index,Object[property]) then
				local num =find(index,Object[property])
				local instance=serverindex[num][2]
				t={reeee,property,instance,Object}
			else
				t={reeee,property,Object[property],Object}
			end
			table.insert(queue,t)
		end
	end)
end

function serverinstance(Object)
	if not find(isserverinstance,Object) and find(ignore,Object) and not Object:IsDescendantOf(Storage) or find(characters,Object) then
		if not Object:IsDescendantOf(game) or Object:IsA("Sound") then
			return;
		end
		local lastvalue=nil
		local lastproperty=nil
		 Object.Changed:Connect(function(a)
			local rs,err = pcall(function()
				local skip=false
				if a==lastproperty or Object[a]==lastvalue then
					for i,v in pairs(queue) do
						if v[1]==Object and v[2]==a then
							table.remove(queue,i)
						end
					end

				elseif Object[a]==Storage or a=="TimePosition" or Object:IsA("Sound") or find(index,Object) then
					skip=true
				end
				if find(blacklist,Object) and not find(index,Object) and not Object:IsDescendantOf(plr.Character) and not Object:IsA("Humanoid") or a=="WalkToPoint" then --and not find(index,Object) --or find(characters,Object)
					skip=true
				end
				if a=="Position" or a=="Origin Position" or a=="Origin Orientation" or a=="Orientation" or string.match(a,"Rotation") then
					if lastvalue["X"] and lastvalue["Y"] and lastvalue["Z"] or typeof(lastvalue)=="Vector3" then
						if Object[a]["X"]+10>lastvalue["X"] or Object[a]["X"]-10<lastvalue["X"] or Object[a]["Y"]+10>lastvalue["Y"] or Object[a]["Y"]-10<lastvalue["Y"] or Object[a]["Z"]+10>lastvalue["Z"] or Object[a]["Z"]-10<lastvalue["Z"] then
							skip=true
						end
					end
				end
				if not Object:IsDescendantOf(game) and a~="Parent" then
					return;
				end
				if skip~=true then
					local t={Object,a,Object[a],Object}
					table.insert(queue,t)
					lastproperty=a
					lastvalue=Object[a]
				end
			end)
		end)
	end
end

function replicate(Object)
	local rs,err = pcall(function()
		local skip=false
		local objpar=Object.Parent
		local parent=objpar
		if find(index,objpar) then
			local indexx=find(index,objpar)
			if serverindex[indexx][2]~=nil and serverindex[indexx][2]:IsDescendantOf(game) then
				parent=serverindex[indexx][2]
			end
		end
		local reeee = remote:InvokeServer("EasyCreation",Object.ClassName,parent,Object.Name,Object)
		if typeof(reeee)~="Instance" then
			if not find(people,Object) then
				table.insert(ignore,Object)
				serverinstance(Object)
			end
		else
			if typeof(reeee)=="Instance" then
				local t={Object,reeee}
				table.insert(serverindex,t)
				table.insert(index,Object)
				local function verifyintegrity(Object,reeee)
					local find=find(index,Object)
					if serverindex[find][1]~=Object then
						for i,v in pairs(serverindex) do
							if v[1]==Object then
								table.remove(serverindex,i)
							end
						end
						table.remove(index,find)
						table.insert(index,Object)
						local t={Object,reeee}
						table.insert(serverindex,t)
						verifyintegrity(Object,reeee)
					end
				end
				Object.Changed:connect(function(property)
					partchanged(Object,reeee,property)
				end)
				reeee.Changed:Connect(function(property)
					pcall(function()
						if reeee[property]~=Object[property] and find(Data,property) then
							property=Object[property]
							for i,v in pairs(queue) do
								if v[2]==property and v[1]==reeee then
									table.remove(queue,i)
								end
							end
							local t={}
							if find(index,Object[property]) then
								local num =find(index,Object[property])
								local instance=serverindex[num][2]
								t={reeee,property,instance,Object}
							else
								t={reeee,property,Object[property],Object}
							end
							table.insert(queue,t)
						end
					end)
				end)
				local rs,err = pcall(function()
					if  not reeee:IsDescendantOf(game:GetService("Lighting")) and not reeee:IsA("Decal") then
						table.insert(belongsinstorage,reeee)
					end
				end)
				verifyintegrity(Object,reeee)
				updateproperties(Object,reeee)
			end
		end
	end)
end


--functions--


for i,a in pairs(game:GetDescendants()) do
	local rs,err = pcall(function()
		table.insert(ignore,a)
		serverinstance(a)
	end)
end

game.DescendantAdded:Connect(function(Object)
	pcall(function()
	if Object.Parent==workspace and game:GetService("Players"):FindFirstChild(Object.Name) and Object:IsA("Model") then
		table.insert(people,Object)
	end
	if not find(failed,Object) and find(index,Object.Parent) and not Object:IsDescendantOf(game:GetService("Players")) or find(ignore,Object.Parent) and not Object:IsDescendantOf(plr.PlayerGui) then
		replicate(Object)
	elseif not find(index,Object.Parent) and not find(ignore,Object.Parent) and not Object:IsDescendantOf(game:GetService("Players")) then
		table.insert(failed,Object)
		end
	end)
end)

game:GetService("RunService").Heartbeat:Connect(function()
	for i,v in pairs(failed) do
		if find(index,v.Parent) then
			table.remove(failed,i)
			replicate(v)
		end
	end
	for i,v in pairs(ignore) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) and v.Name~="BASE" then
			local t ={v,"Parent",nil}
			table.insert(aaa,t)
			table.remove(ignore,i)
			end
		end)
		if err then
			table.remove(ignore,i)
		end
	end
end)

game:GetService("Players").PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function(a)
		savedu=true
		wait(1)
table.insert(characters,a)
		table.insert(ignore,a)
		serverinstance(a)
		for i,l in pairs(a:GetDescendants()) do
			local rs,err = pcall(function()
				table.insert(characters,l)
				table.insert(ignore,l)
				serverinstance(l)
			end)
		end
	end)
	savedu=false
end)

for i,plr in pairs(game:GetService("Players"):GetPlayers()) do
	plr.CharacterAdded:Connect(function(a)
		savedu=true
		wait(1)
		table.insert(characters,a)
		table.insert(ignore,a)
		serverinstance(a)
		for i,l in pairs(a:GetDescendants()) do
			local rs,err = pcall(function()
				table.insert(characters,l)
				table.insert(ignore,l)
				serverinstance(l)
			end)
		end
	end)
	savedu=false
end

remote2.OnClientEvent:Connect(function(Obj)
	for i,v in pairs(characters) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(characters,i)
			end
		end)
	end
	for i,v in pairs(ignore) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(ignore,i)
			end
		end)
	end
	for i,v in pairs(people) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(people,i)
			end
		end)
	end
	for i,v in pairs(anti) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(anti,i)
			end
		end)
	end
	for i,v in pairs(isserverinstance) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(isserverinstance,i)
			end
		end)
	end
	for i,v in pairs(failed) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(failed,i)
			end
		end)
	end
	for i,v in pairs(antimoveparent) do
		local rs,err = pcall(function()
		if not v:IsDescendantOf(game) then
			table.remove(antimoveparent,i)
			end
		end)
	end
	for i,v in pairs(Obj) do
		local rs,err = pcall(function()
		if not find(blacklist,v) then
			table.insert(blacklist,v)
			end
		end)
	end
end)

local counter=0

local ensurance={}

local posinindex=0
function checktherest()
	for i,v in pairs(serverindex) do
		local rs,err = pcall(function()
			if v[1]~=nil and v[2]~=nil and typeof(v[1])=="Instance" and typeof(v[2])=="Instance" then
				if not v[1]:IsDescendantOf(game) and v[2]:IsDescendantOf(game) then
					local t ={v[2],"Parent",nil}
					table.insert(aaa,t)
					table.remove(serverindex,i)
					table.remove(index,i)
					v[2]:Destroy()
				elseif not v[2]:IsDescendantOf(game) then
					if v[1]:IsDescendantOf(game) then
						v[1]:Destroy()
					end
					table.remove(serverindex,i)
					table.remove(index,i)
				end
			end
		end)
	end
	if counter>0.2 then
for i,v in pairs(serverindex) do
		local rs,err = pcall(function()
		if v[1]:IsDescendantOf(game) and not find(ensurance,v[1]) then
			updateproperties(v[1],v[2])
			table.insert(ensurance,v[1])
		end
		end)
		end
		local localcounter=0
	repeat 
			localcounter=localcounter+1
			posinindex=posinindex+1
		local v = serverindex[posinindex]
			local rs,err = pcall(function()
				if v[1]:IsDescendantOf(game) then
					updateproperties(v[1],v[2])
				end
			end)
	until
	localcounter>=20 or posinindex>=#serverindex
		if posinindex>=#serverindex then
			posinindex=0
		end
	counter=0
	end
end

local function loop()
	counter=counter+cooldown
	checktherest()
	for i,ll in pairs(belongsinstorage) do
		if not ll:IsDescendantOf(game) then
			table.remove(belongsinstorage,i)
		elseif not ll:IsDescendantOf(Storage) then
			pcall(function()
				ll.Parent = Storage
			end)
		end
	end
	for i,v in pairs(queue) do
		if typeof(v[3])~="Instance" then
		v[3]=v[4][v[2]]
		end
	end
	if aaa[1]~=nil then
		remote2:FireServer("Property",aaa)
		aaa={}
	end
	if queue[1]~=nil then
		remote2:FireServer("Property",queue)
		queue={}
	end
	wait(cooldown)
	loop()
end

loop()]]></ProtectedString>
			</Properties>
		</Item>

	</Item>
</roblox>
