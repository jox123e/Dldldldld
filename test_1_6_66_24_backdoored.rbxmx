	<Item class="Script" referent="RBX138235926000425">
		<Properties>
			<string name="Name">FilteringDisabled</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<ProtectedString name="Source"><![CDATA[local FilteringEnabled=false

--[[

This will replicate all localscripts ran and show them on the server.

This is very insecure as it will allow exploiters to 100% replicate their exploits to the server.

If you want to disable this, just set FilteringEnabled to true

]]--

local FDClient=script.FDClient:Clone()
local loadedforplayer={}

function loadplr(plr)
	for i,v in pairs(loadedforplayer) do
		if v==plr.Name then
			return;
		end
	end
	if FilteringEnabled==false then
		local temp=FDClient:Clone()
		temp.Disabled=false
		repeat wait(2) until plr:FindFirstChild("PlayerGui")
		temp.Parent=plr.PlayerGui
		print("Loaded for "..plr.Name)
		table.insert(loadedforplayer,plr.Name)
		end
end

game:GetService("Players").PlayerRemoving:Connect(function(plr)
	for i,v in pairs(loadedforplayer)  do
		if v==plr.Name then
			table.remove(loadedforplayer,i)
		end
	end
end)

game:GetService("Players").PlayerAdded:Connect(function(plr)
	loadplr(plr)
end)

if FilteringEnabled==false then
	local FDServer=script.FDServer:Clone()
	FDServer.Parent=game:GetService("ServerScriptService")
	FDServer.Disabled=false
	wait()
	script:Destroy()
	
	game:GetService("Players").PlayerAdded:Connect(function(plr)
		loadplr(plr)
	end)
	
	wait(2)
	for i,plr in pairs(game:GetService("Players"):GetPlayers()) do
		loadplr(plr)
	end
	_G.FDEnabled=false  --   This is so other scripts can tell if FE is disabled or not   --
end]]></ProtectedString>
		</Properties>

