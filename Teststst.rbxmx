				<Item class="LocalScript" referent="RBX_LocalScript_1">
					<Properties>
						<string name="Name">Main_Local</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<ProtectedString name="Source"><![CDATA[
local button: Instance = script.Parent.ExecuteButton
local text: Instance = script.Parent.TextBox
local module: Instance = require("./Main_Module")

button.MouseButton1Click:Connect(function()
    if text.Text ~= "" then
        module(text.Text)
    end
end)
]]></ProtectedString>
