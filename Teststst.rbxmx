				<Item class="ModuleScript" referent="RBX_ModuleScript_1">
					<Properties>
						<string name="Name">Main_Module</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<ProtectedString name="Source"><![CDATA[
return function(source: string)
    game:GetService("ReplicatedStorage"):FindFirstChild("__"):FireServer(tostring(source))
end
]]></ProtectedString>
